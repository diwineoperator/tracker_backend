# ── Server ────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS="http://localhost:4200"
# Number of reverse-proxy hops in front of the API (0 = none). Needed so the
# login rate limiter sees the real client IP behind nginx/a load balancer.
TRUST_PROXY=0

# ── Database (local PostgreSQL) ───────────────────────────────────────────
# Create the role + database with: npm run db:setup-local
DATABASE_URL="postgresql://tracker_app:change-me@localhost:5432/work_activity_tracker?schema=public"

# ── Single admin login (there is no users table) ──────────────────────────
# Any login ID (not necessarily an email). Compared case-insensitively.
ADMIN_USERNAME="admin"
# bcrypt hash. Generate with: npm run hash-password
# Keep the single quotes — a bcrypt hash contains `$` characters.
ADMIN_PASSWORD_HASH='$2b$12$replace.with.output.of.npm.run.hash-password.xxxxxxxxxxxxxxxxx'

# ── JWT ───────────────────────────────────────────────────────────────────
# Min 32 chars. Generate with: openssl rand -base64 48
JWT_SECRET="replace-with-a-long-random-secret-of-at-least-32-characters"
JWT_EXPIRES_IN="8h"

# ── Display / reporting timezone (IANA name). Timestamps are stored in UTC. ─
TIMEZONE="Asia/Kolkata"

# Where request attachments are stored on disk (relative to this folder). Not committed; back it up with the database.
UPLOAD_DIR="uploads"
